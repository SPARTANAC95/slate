{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Slate",
  "version": "0.1.1",
  "identifier": "com.slate.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Slate",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://image.tmdb.org https://images.igdb.com https://shared.akamai.steamstatic.com https://media.rawg.io data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOTA3MEUzOEY5RUFBMDgKUldRSXFwNlA0M0NRclQxYjdQM3Y4T25oQTEvMTdXSnlVQUlrbElyWDBZQWZZOE5Iakk3OHA5WGIK",
      "endpoints": ["https://github.com/SPARTANAC95/slate/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
