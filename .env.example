# Copy to .env — keys are only read by the proxy server, never the client bundle.
# The app runs without any of them (manual entry only).
TMDB_API_KEY=

# Games. Optional: with nothing here they come from the Steam store instead,
# which needs no key. Register a Twitch application at
# dev.twitch.tv/console/apps to get the pair.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
