{
  "name": "slate",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:app": "tauri dev",
    "build:app": "tauri build --config tools/tauri-check.conf.json",
    "release:build": "node tools/release.mjs build",
    "release:publish": "node tools/release.mjs publish",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "description": "A local-first Windows calendar for releases, plans, and the things you look forward to.",
  "author": "SPARTANAC95",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SPARTANAC95/slate.git"
  },
  "homepage": "https://spartanac95.github.io/slate/",
  "bugs": {
    "url": "https://github.com/SPARTANAC95/slate/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
